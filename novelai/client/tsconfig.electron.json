{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist-electron",
    "rootDir": ".",
    "strict": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "allowJs": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "electron/main.ts",
    "electron/preload.ts",
    "electron/ipc/**/*.ts",
    "src/types.ts",
    "src/png-meta.ts",
    "src/anlas.ts",
    "src/error-message.ts",
    "electron/bootstrap.ts",
    "electron/image-study-worker.ts",
    "electron/library/history-tag-index-worker.ts",
    "shared/runtime/*.cjs"
  ],
  "exclude": [
    "electron/**/*.test.ts"
  ]
}
