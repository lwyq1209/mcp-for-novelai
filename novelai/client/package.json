{
  "name": "mcp-for-novelai",
  "version": "0.1.3",
  "private": true,
  "description": "MCP for NovelAI: a desktop NovelAI image generation client that AI agents use through MCP.",
  "author": "lwyq1209",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lwyq1209/mcp-for-novelai.git"
  },
  "homepage": "https://github.com/lwyq1209/mcp-for-novelai#readme",
  "main": "dist-electron/electron/bootstrap.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:electron": "wait-on http://127.0.0.1:5173 && npm run build:electron && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:dev-tools": "node --test \"dev-tools/tests/*.test.mjs\"",
    "start": "npm run build && electron .",
    "pack:dir": "npm run build && npm run notices:check && electron-builder --dir --publish never",
    "dist": "npm run build && npm run notices:check && electron-builder --win nsis --publish never",
    "dist:mac": "npm run build && npm run notices:check && electron-builder --mac --publish never",
    "dist:linux": "npm run build && npm run notices:check && electron-builder --linux tar.gz --publish never",
    "build:icons": "node scripts/build-icons.mjs",
    "notices": "node scripts/generate-notices.mjs",
    "notices:check": "node scripts/generate-notices.mjs --check"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "ajv": "8.20.0",
    "axios": "^1.13.2",
    "form-data": "^4.0.6",
    "http-proxy-agent": "^5.0.0",
    "https-proxy-agent": "^5.0.1",
    "jszip": "^3.10.1",
    "pngjs": "^7.0.0",
    "sharp": "0.35.4",
    "socks-proxy-agent": "^7.0.0",
    "unzipper": "0.12.3"
  },
  "devDependencies": {
    "@tanstack/react-query": "5.102.8",
    "@types/node": "^24.10.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "0.28.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0",
    "typebox": "1.1.38",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.11",
    "wait-on": "^9.0.10",
    "zustand": "^5.0.9"
  },
  "overrides": {
    "ip-address": "10.7.0",
    "js-yaml": "4.3.2",
    "sharp": "0.35.4",
    "tar": "7.5.22"
  },
  "build": {
    "appId": "io.github.lwyq1209.mcp-for-novelai",
    "productName": "MCP for NovelAI",
    "artifactName": "MCP-for-NovelAI-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/@img/sharp-*/**/*"
    ],
    "compression": "maximum",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "!**/*.map",
      "!**/.jekyll-metadata",
      "package.json"
    ],
    "publish": null,
    "extraResources": [
      {
        "from": "dist-mcp",
        "to": "mcp",
        "filter": [
          "novelai-mcp.mjs"
        ]
      },
      {
        "from": "../../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "MCP-for-NovelAI-${version}-win-${arch}-setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MCP for NovelAI",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.graphics-design",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extraResources": [
        {
          "from": "node_modules/electron/dist/LICENSES.chromium.html",
          "to": "LICENSES.chromium.html"
        }
      ],
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Graphics",
      "target": [
        "tar.gz"
      ]
    },
    "npmRebuild": false,
    "afterPack": "scripts/mac-sign-hook.cjs"
  },
  "allowScripts": {
    "electron@42.11.0": true,
    "electron-winstaller@5.4.0": true
  }
}
